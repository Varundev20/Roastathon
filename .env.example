# Settings are read from environment variables (defaults shown).
# Never commit a real key. On Render, set these under Environment.

# --- AI provider ---------------------------------------------------------------
# "gemini" (hosted, used for the Render deployment) or "ollama" (local, offline).
# If unset: gemini when GEMINI_API_KEY is present, otherwise ollama.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high (Gemini 3 models cannot turn thinking off)
GEMINI_REASONING_EFFORT=low
GEMINI_MAX_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=120

# Local mode only. PowerShell example:  $env:LLM_PROVIDER = "ollama"; streamlit run frontend/app.py
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=300

# --- Data and detection ----------------------------------------------------------
# Optional: folder with the full CICIDS2017 CSV files
NODE_SENTINEL_INPUT_DIR=../Input_csv
NODE_SENTINEL_DB_PATH=node_sentinel.db
NODE_SENTINEL_BURST_THRESHOLD=3000
NODE_SENTINEL_PORT_SPREAD_THRESHOLD=50
